PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ratanmahal
# Atlas: copy Connect > Drivers from the correct project/cluster, for example:
# MONGODB_URI="mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/ratanmahal?retryWrites=true&w=majority&authSource=admin"
# Replace placeholders. Encode username/password components exactly once,
# not the entire URI. Database users differ from Atlas account logins.
# Deployment/shell variables take precedence over backend/.env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-oauth-client-id
FRONTEND_ORIGIN=http://localhost:5173
# Used only by `npm run admin:init` when no Admin account exists.
# Set these in your ignored backend/.env only for the one-time first-admin setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
